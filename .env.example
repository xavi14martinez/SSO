# Valores solo para el entorno local de desarrollo. No usarlos en producción.
PORT=3000
APP_BASE_URL=http://localhost:3000
SESSION_SECRET=dev-only-session-secret
OIDC_ISSUER_URL=http://localhost:8080/realms/sso-portal
OIDC_CLIENT_ID=portal-web
OIDC_CLIENT_SECRET=dev-only-portal-secret
OIDC_REDIRECT_URI=http://localhost:3000/callback
# En HTTP local la cookie no puede marcarse Secure. Con HTTPS, poner true.
COOKIE_SECURE=false
